# Copy to .env and fill in your token. Never commit .env.

BELLHAVEN_URL=https://analyst-assessment-production.up.railway.app
CRM_API_BASE_URL=https://analyst-assessment-production.up.railway.app/api/v1
# Your candidate token. Sent only as "Authorization: Bearer <token>".
CRM_API_TOKEN=replace-with-your-token

# Optional. Leave blank to auto-detect the single top-level "Bellhaven Senior Living" account.
BELLHAVEN_PARENT_ACCOUNT_ID=

# Keep false until you have reviewed proposals and want approved changes written.
CRM_WRITE_ENABLED=false

DECISIONS_DB_PATH=data/decisions.db
DECISIONS_LEDGER_PATH=decisions/ledger.jsonl
REVIEWER_NAME=
LOG_LEVEL=INFO
